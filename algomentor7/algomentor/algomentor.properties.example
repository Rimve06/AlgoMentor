# Copy to "algomentor.properties" (same folder, next to pom.xml). Git-ignored - safe for real secrets.

# --- AI (live chat, Compare Algorithms, AI problem generation) ---
# Groq is FREE with NO credit card: console.groq.com -> sign up -> API Keys -> create one.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Only needed if you set AI_PROVIDER=openai instead:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email (real verification code + welcome email) ---
# MAIL_PASSWORD must be a Gmail "App Password" (Google Account -> Security ->
# 2-Step Verification -> App passwords) - your normal Gmail password is always rejected.
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your16digitapppassword

# --- Anthropic (no longer used - the "Get AI Tip" box was replaced by the AI Mentor Chat; safe to leave blank) ---
ANTHROPIC_API_KEY=

# --- One-time database reset (see SETUP_NOTES.md) ---
# Set to true for ONE run to wipe old test accounts, then set back to false.
RESET_DB_ON_START=false
